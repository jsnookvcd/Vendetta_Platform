MODULE_ENABLED=true
# Generated by the deployment in AWS. For a laptop, any long random string; a
# placeholder refuses to boot unless ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
# Bearer other modules present to this module's service API (blank derives one from SECRET_KEY).
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=mdr
# Dedicated keys (generated by the deployment); blank derives from SECRET_KEY with a warning.
ENCRYPTION_KEY=
EVIDENCE_SIGNING_KEY=
# This console's public URL, for links from the control plane and in findings.
PUBLIC_URL=

# Control plane: client and staff roster pulls every PROVISION_INTERVAL_SECONDS and on push.
PLATFORM_URL=http://platform:8000
PLATFORM_TOKEN=
PLATFORM_PUBLIC_URL=
PROVISION_INTERVAL_SECONDS=300

# IR hub for escalation (blank = standalone, escalation is a no-op).
PLATFORM_HUB_URL=http://incident-response:8000
PLATFORM_HUB_TOKEN=

# Managed services: the signal source (its API_TOKEN) and its public console URL,
# which containment hand-offs link to as {MANAGED_SERVICES_PUBLIC_URL}/alerts/{id}.
MANAGED_SERVICES_URL=http://managed-services:8000
MANAGED_SERVICES_TOKEN=
MANAGED_SERVICES_PUBLIC_URL=
# Seconds between detection runs (0 disables the schedule; POST /api/detect/run still works).
DETECT_INTERVAL_SECONDS=120
# How far back a run looks when deciding to open an investigation.
DETECT_LOOKBACK_MINUTES=1440
# Default life of a "This was noise" suppression, in days (1 to 90).
NOISE_SUPPRESSION_DAYS=30

# Optional RFC 3161 Time-Stamp Authority for evidence exports.
TSA_URL=

# Microsoft 365 / Entra ID SSO (blank = admin login only; can also be set in-app)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
ENTRA_ALLOWED_GROUP=
ENTRA_ALLOWED_EMAILS=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

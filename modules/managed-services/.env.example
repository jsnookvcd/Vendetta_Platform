MODULE_ENABLED=true
# A placeholder SECRET_KEY refuses to boot unless ALLOW_INSECURE_DEFAULTS=true (laptops only).
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
# Bearer other modules present to this module (blank derives one from SECRET_KEY).
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=msp
PUBLIC_URL=
# Dedicated keys (generated by the deployment); blank derives from SECRET_KEY with a warning.
ENCRYPTION_KEY=
EVIDENCE_SIGNING_KEY=
# Optional RFC 3161 Time-Stamp Authority for court-admissible evidence exports.
TSA_URL=

# Microsoft 365 / Entra ID SSO (blank = admin login only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
ENTRA_ALLOWED_GROUP=
ENTRA_ALLOWED_EMAILS=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

# SuperOps: token from My Profile > API token; subdomain from Settings > My MSP
SUPEROPS_API_URL=https://api.superops.ai/msp
SUPEROPS_API_TOKEN=
SUPEROPS_SUBDOMAIN=
SUPEROPS_BASE_URL=
SUPEROPS_DEFAULT_TECHGROUP_ID=

# SentinelOne: service-user API token scoped to the MSP account
SENTINELONE_URL=
SENTINELONE_API_TOKEN=

# CrowdStrike Falcon: MSSP parent (Flight Control) API client
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_CONSOLE_URL=https://falcon.crowdstrike.com

# Huntress: user-based API key (account keys cannot approve remediations)
HUNTRESS_API_KEY=
HUNTRESS_API_SECRET=
HUNTRESS_BASE_URL=

# Acronis Cyber Protect Cloud: partner API client on your data center
ACRONIS_DC_URL=
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=

# Safety: ACTIONS_READONLY=true disables every tool write (isolate, contain,
# quarantine, run backup, resolve at source) while validating a new client.
ACTIONS_READONLY=true

# Sync and escalation into the IR hub
SYNC_INTERVAL_SECONDS=300
PLATFORM_HUB_URL=
PLATFORM_HUB_TOKEN=

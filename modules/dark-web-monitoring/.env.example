# Copy to .env for local dev. In AWS, scripts/render_env.sh builds this from SSM Parameter Store.
SECRET_KEY=replace-with-64-random-chars
COOKIE_SECURE=false        # set true once served over TLS
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=            # python scripts/make_password_hash.py; break-glass admin

# Microsoft 365 / Entra ID SSO (leave ENTRA_CLIENT_ID blank to use password login only)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=            # https://<host>/auth/callback
ENTRA_ALLOWED_GROUP=          # optional group object ID required in the token
ENTRA_ALLOWED_EMAILS=         # optional comma-separated allowlist
POSTGRES_PASSWORD=darkweb

# Evidence: leave blank to keep captures on local disk
EVIDENCE_BUCKET=
AWS_REGION=us-east-1

# Collectors (all optional)
HIBP_API_KEY=
RANSOMWARE_LIVE_API_KEY=      # free PRO key from https://my.ransomware.live (needed for business use)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=

# Alerts
ALERT_MIN_SEVERITY=medium
SNS_TOPIC_ARN=
TEAMS_WEBHOOK_URL=
# Jira is off unless JIRA_BASE_URL is set. Leave blank until the IR desk is live.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IR
JIRA_ISSUE_TYPE=Task
JIRA_MIN_SEVERITY=high

# Vendetta Platform integration (leave blank to run standalone)
PLATFORM_HUB_URL=
PLATFORM_HUB_TOKEN=

# Cadence (minutes)
LEAK_FEED_INTERVAL=30
ONION_CRAWL_INTERVAL=120
HIBP_INTERVAL=360
CT_INTERVAL=360
PASTE_INTERVAL=60

# Cadence addition
FORUM_CRAWL_INTERVAL=180

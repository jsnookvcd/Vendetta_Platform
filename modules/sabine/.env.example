MODULE_ENABLED=true
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=sabine
ENCRYPTION_KEY=
EVIDENCE_SIGNING_KEY=
PUBLIC_URL=

# Control plane (staff roster for console access; client directory; readiness)
PLATFORM_URL=http://platform:8000
PLATFORM_TOKEN=
PLATFORM_PUBLIC_URL=

# Everything SABINE may reach, with each module's own token (rendered by the deployment)
MODULE_DIRECTORY={"platform": {"base_url": "http://platform:8000", "token": "", "public_url": ""}, "incident-response": {"base_url": "http://incident-response:8000", "token": "", "public_url": ""}}
ACTOR_NAME=sabine

# The board (wall display): open /board?k=<KIOSK_TOKEN> once on the screen. Blank = staff sessions only.
KIOSK_TOKEN=
BOARD_REFRESH_SECONDS=30

# Spoken voice: browser (default, no key), elevenlabs or azure. Listening is always in the browser.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Azure: create a Speech resource in a region that serves Dragon HD voices (East US works),
# then set its key and region here. Jane (Dragon HD) is SABINE's voice; Ava Dragon HD
# (en-US-Ava:DragonHDLatestNeural) is the alternate.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-Jane:DragonHDLatestNeural

# Cycle every N seconds (0 = only when run from the console or /api/run)
CYCLE_INTERVAL_SECONDS=120
PROPOSAL_TTL_HOURS=72

# Optional narrative model. Rules decide; the model only writes.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# Internal voice: sabine (warm, confident, dry wit) or plain. Client briefs stay professional either way.
PERSONA=sabine

# Rule thresholds
ESCALATE_AFTER_MINUTES=30
# Triage copilot verdicts on findings: a false positive at or above this confidence
# is queued for confirmation instead of escalated; a true positive at or above this
# confidence raises the escalation proposal's confidence.
COPILOT_FP_CONFIDENCE=0.9
COPILOT_TP_CONFIDENCE=0.85
STALE_CASE_DAYS=5
STALE_ENGAGEMENT_DAYS=30
# The client brief lists what SABINE did on the account inside this many days, redacted for the client.
CLIENT_BRIEF_WINDOW_DAYS=7

# Microsoft 365 / Entra ID SSO (or set in-app)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

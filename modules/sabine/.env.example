MODULE_ENABLED=true
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=sabine
ENCRYPTION_KEY=
EVIDENCE_SIGNING_KEY=
PUBLIC_URL=

# Control plane (staff roster for console access; client directory; readiness)
PLATFORM_URL=http://platform:8000
PLATFORM_TOKEN=
PLATFORM_PUBLIC_URL=

# Everything SABINE may reach, with each module's own token (rendered by the deployment)
MODULE_DIRECTORY={"platform": {"base_url": "http://platform:8000", "token": "", "public_url": ""}, "incident-response": {"base_url": "http://incident-response:8000", "token": "", "public_url": ""}}
ACTOR_NAME=sabine

# Cycle every N seconds (0 = only when run from the console or /api/run)
CYCLE_INTERVAL_SECONDS=120
PROPOSAL_TTL_HOURS=72

# Optional narrative model. Rules decide; the model only writes.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# Internal voice: sabine (warm, confident, dry wit) or plain. Client briefs stay professional either way.
PERSONA=sabine

# Rule thresholds
ESCALATE_AFTER_MINUTES=30
STALE_CASE_DAYS=5
STALE_ENGAGEMENT_DAYS=30

# Microsoft 365 / Entra ID SSO (or set in-app)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

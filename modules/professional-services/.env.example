MODULE_ENABLED=true
# Generated by the deployment in AWS. For a laptop, any long random string; a
# placeholder refuses to boot unless ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
# Bearer other modules present to this module's service API (blank derives one from SECRET_KEY).
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=psvc
# Dedicated keys (generated by the deployment); blank derives from SECRET_KEY with a warning.
ENCRYPTION_KEY=
EVIDENCE_SIGNING_KEY=
# This console's public URL, for links from the control plane.
PUBLIC_URL=

# Control plane: roster pulls every PROVISION_INTERVAL_SECONDS and on push.
PLATFORM_URL=http://platform:8000
PLATFORM_TOKEN=
PLATFORM_PUBLIC_URL=
PROVISION_INTERVAL_SECONDS=300

# IR hub for escalation (blank = standalone, escalation is a no-op).
PLATFORM_HUB_URL=http://incident-response:8000
PLATFORM_HUB_TOKEN=

# Optional RFC 3161 Time-Stamp Authority for court-admissible evidence exports.
TSA_URL=

# Microsoft 365 / Entra ID SSO (blank = admin login only; can also be set in-app)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
ENTRA_ALLOWED_GROUP=
ENTRA_ALLOWED_EMAILS=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

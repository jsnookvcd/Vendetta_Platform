MODULE_ENABLED=true
# Generated by the deployment in AWS. For a laptop, any long random string; a
# placeholder refuses to boot unless ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
# Bearer other modules present to this module's service API (blank derives one from SECRET_KEY).
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=pmtool
ENCRYPTION_KEY=
# Public HTTPS URL (https://pm.vendettacyber.io). The Claude connector's OAuth metadata
# is built from it, so it must be set before anyone connects Claude.
PUBLIC_URL=

# Control plane: client and staff roster pulls every PROVISION_INTERVAL_SECONDS and on push.
PLATFORM_URL=http://platform:8000
PLATFORM_TOKEN=
PLATFORM_PUBLIC_URL=
PROVISION_INTERVAL_SECONDS=300

# Harvest (can also be set in-app on Integrations): an administrator's personal access token.
HARVEST_ACCOUNT_ID=
HARVEST_TOKEN=

# SharePoint mirror for meeting notes. Blank GRAPH_* falls back to the Entra SSO app.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_FOLDER=Engagements
SHAREPOINT_RETRY_SECONDS=600

# Claude connector: redirect URIs a dynamically registered OAuth client may use.
MCP_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1

# Microsoft 365 / Entra ID SSO (blank = admin login only; can also be set in-app)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
ENTRA_ALLOWED_GROUP=
ENTRA_ALLOWED_EMAILS=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

# Project kickoff (/kickoff). Each engagement is a private channel in its practice
# team. Graph needs User.Read.All, GroupMember.ReadWrite.All, Channel.Create,
# Channel.ReadBasic.All, ChannelMember.ReadWrite.All, ChannelSettings.ReadWrite.All,
# Files.ReadWrite.All, Sites.ReadWrite.All (Vendetta Time lists), TeamsTab.Create,
# and for the optional parts TeamsAppInstallation.ReadWriteForTeam.All, Mail.ReadWrite
# and MailboxSettings.ReadWrite. The team ids are the practice teams' group ids.
KICKOFF_IR_TEAM_ID=
KICKOFF_PROSERV_TEAM_ID=
KICKOFF_CHANNEL_OWNERS=
KICKOFF_IR_ALWAYS_MEMBERS=
KICKOFF_PROSERV_ALWAYS_MEMBERS=
KICKOFF_CHANNEL_WARN_AT=900
KICKOFF_IR_MAILBOX=ir@vendettacd.io
KICKOFF_PROSERV_MAILBOX=ps@vendettacd.io
KICKOFF_TIME_CHANNEL_NAME=Time Entry
KICKOFF_FOLDERS_IR=Evidence,Evidence/Client Uploads,Evidence/Collections,Analysis,Reports,Correspondence,Meeting Notes
KICKOFF_FOLDERS_PROSERV=Contracts,Client Uploads,Working,Deliverables,Correspondence,Meeting Notes
KICKOFF_HARVEST_TASKS_IR=Incident Response,Forensic Analysis,Project Management,Reporting,Internal (Non-billable)
KICKOFF_HARVEST_TASKS_PROSERV=Consulting,Project Management,Reporting,Internal (Non-billable)
KICKOFF_HARVEST_NONBILLABLE_TASKS=Internal (Non-billable)
KICKOFF_HARVEST_BUDGET_ALERT_PCT=80
# Vendetta Time site, and the published Power App's Teams app id and tab URL
# ({teamId}, {channelId} and {code} are filled in). Blank site skips Vendetta Time.
KICKOFF_VTIME_SITE_URL=https://vendettacd.sharepoint.com/sites/VendettaTime
KICKOFF_VTIME_TEAMS_APP_ID=
KICKOFF_VTIME_TAB_CONTENT_URL=
KICKOFF_DRAFT_CLIENT_EMAIL=true
KICKOFF_RETRY_SECONDS=60
KICKOFF_MAX_ATTEMPTS=30
# Ticketing provider for the kickoff ticket step (none until one is chosen).
KICKOFF_TICKETING=none

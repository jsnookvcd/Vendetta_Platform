MODULE_ENABLED=true
# A placeholder SECRET_KEY refuses to boot unless ALLOW_INSECURE_DEFAULTS=true (laptops only).
SECRET_KEY=replace-with-64-random-chars
ALLOW_INSECURE_DEFAULTS=false
# Bearer other modules present to this module (blank derives one from SECRET_KEY).
API_TOKEN=
COOKIE_SECURE=false
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
POSTGRES_PASSWORD=platform

# Microsoft 365 / Entra ID SSO (staff only; blank = admin login)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=
ENTRA_ALLOWED_GROUP=
ENTRA_ALLOWED_EMAILS=
INTERNAL_EMAIL_DOMAINS=vendettacd.io
ADMIN_EMAILS=

# Overview probe cache (seconds)
PROBE_CACHE_SECONDS=45
